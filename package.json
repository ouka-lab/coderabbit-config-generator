{
    "name": "coderabbit-config-generator",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "packageManager": "pnpm@11.3.0",
    "scripts": {
        "generate:examples": "pnpm --filter @coderabbit-config/core generate:examples",
        "dev": "pnpm generate:examples && pnpm --filter @coderabbit-config/web dev",
        "build": "pnpm typecheck && pnpm --filter @coderabbit-config/web build",
        "build:vscode": "pnpm typecheck && pnpm --filter @coderabbit-config/vscode build",
        "preview": "pnpm --filter @coderabbit-config/web preview",
        "typecheck": "pnpm generate:examples && pnpm -r typecheck",
        "test": "pnpm generate:examples && vitest run",
        "test:coverage": "pnpm generate:examples && vitest run --coverage",
        "test:e2e": "pnpm generate:examples && pnpm --filter @coderabbit-config/web test:e2e",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "deploy": "pnpm build && firebase deploy --only hosting"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.49.0",
        "vitest": "^4.1.10"
    },
    "volta": {
        "node": "22.22.2",
        "pnpm": "11.3.0"
    }
}
