{
    "name": "@coderabbit-config/vscode",
    "displayName": "CodeRabbit Config Generator",
    "description": "Build a .coderabbit.yaml through a form and write it straight into your workspace.",
    "private": true,
    "version": "1.1.0",
    "publisher": "ysknsid25",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "coderabbitConfig.open",
                "title": "Open Config Generator",
                "category": "CodeRabbit"
            }
        ]
    },
    "scripts": {
        "build:webview": "vite build",
        "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
        "build": "pnpm build:webview && pnpm build:extension",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@coderabbit-config/ui": "workspace:*",
        "@formisch/react": "^1.0.0-rc.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/vscode": "^1.90.0",
        "@vitejs/plugin-react": "^5.0.0",
        "esbuild": "^0.28.2",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.2",
        "typescript": "^5.7.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10"
    }
}
